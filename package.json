{
  "name": "psg-survey",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "create-admin": "tsx --conditions=react-server --env-file-if-exists=.env scripts/create-admin.ts",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env src/worker/index.ts",
    "seed:demo": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-demo-instrument.ts",
    "load-test": "tsx --conditions=react-server --env-file-if-exists=.env scripts/load-test.ts",
    "restore-drill": "tsx --conditions=react-server --env-file-if-exists=.env scripts/restore-drill.ts",
    "test:e2e": "playwright test",
    "seed:dashboard": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-demo-dashboard.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "pg-boss": "^12.34.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
