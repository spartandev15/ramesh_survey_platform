# Copy to .env and fill in values. Never commit .env.

# PostgreSQL 17 connection string. Works with local Postgres, Docker, Supabase, RDS, etc.
# Supabase: use the direct or session-pooler connection (not transaction pooler) so the worker works.
DATABASE_URL=postgres://psg:psg@localhost:5432/psg_survey

# Public base URL of the app (used in emails and auth callbacks).
APP_URL=http://localhost:3000

# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Email provider: "log" prints emails to the server log (development), "sendgrid" sends real email.
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@example.com
SENDGRID_API_KEY=

# trace | debug | info | warn | error
LOG_LEVEL=info
