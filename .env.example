# Copy to .env and fill in values. Never commit .env.

# PostgreSQL 17 connection string. Works with local Postgres, Docker, Supabase, RDS, etc.
# Supabase: use the direct or session-pooler connection (not transaction pooler) so the worker works.
DATABASE_URL=postgres://psg:psg@localhost:5432/psg_survey
# Connections per process: the app pool and the worker's job queue (both default 10). Keep the total over all
# web processes and the worker under the database's limit (Supabase session pooler: 15), e.g. 3 and 2.
DATABASE_POOL_MAX=
QUEUE_POOL_MAX=

# Public base URL of the app (used in emails and auth callbacks).
APP_URL=http://localhost:3000

# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Email provider: "log" prints emails to the server log (development), "sendgrid" sends real email.
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@example.com
SENDGRID_API_KEY=
# Public key from SendGrid > Mail Settings > Event Webhook (signed events). Required to accept delivery events.
SENDGRID_WEBHOOK_PUBLIC_KEY=

# PSG operations addresses for stuck-queue alerts and the daily count report, comma separated.
# Leave empty to only log them. Also point an uptime monitor at /api/health (503 when the worker stops).
OPS_ALERT_EMAILS=

# Optional help address shown to customers whose expired link cannot be renewed. Empty: they are told to contact the shop.
SURVEY_HELP_EMAIL=

# trace | debug | info | warn | error
LOG_LEVEL=info

# Proxies in front of the app that append to X-Forwarded-For, used for rate limits. Default 1: one reverse
# proxy that overwrites the header with the client address. Never expose the app port without it: a client
# could then send any address. Sign-in limits need the header to hold exactly one address.
TRUSTED_PROXY_HOPS=

# Optional key for opt-out links (32+ characters). When empty it is derived from BETTER_AUTH_SECRET.
# Set it before you ever rotate BETTER_AUTH_SECRET: links sent before it was set still work while that
# secret is unchanged, and links sent after it keep working through any later rotation.
OPT_OUT_SECRET=

# Development only: keep the newest N rows per growing table; the worker prunes every 15 minutes. Leave unset in production.
# DEV_PRUNE_KEEP=100
